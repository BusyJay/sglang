# User-provided image derived from SGLang v0.5.21. Pin a tag or digest.
SGLANG_IMAGE=your-sglang-v0.5.21-image:tag

# Absolute host path for test results.
RESULTS_HOST=/path/to/qwen38-results

# Host GPU indices or UUIDs accepted by Docker --gpus device=...
GPU_4080=1
GPU_5090=0

# Test limits.
GPU_SMALL_BUDGET_GIB=8

# Optional Docker flags, space-separated. Keep simple; commands use bash arrays.
DOCKER_EXTRA_ARGS=
