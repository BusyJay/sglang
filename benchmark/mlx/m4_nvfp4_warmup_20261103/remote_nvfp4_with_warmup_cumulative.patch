+            inputs=[indices.reshape(-1), mx.array([indices.size], mx.uint32)],
+            grid=(indices.size, 1, 1),
+            threadgroup=(32, 1, 1),
+            output_shapes=[(indices.size,), (indices.size,)],
+            output_dtypes=[mx.uint32, mx.uint32],
+        )
+    )
