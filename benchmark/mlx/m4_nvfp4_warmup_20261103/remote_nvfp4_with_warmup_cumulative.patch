+   d1+=(x1[4*j]*w0+x1[4*j+1]*w1+x1[4*j+2]*w2+x1[4*j+3]*w3);
+  }
+  {
+#pragma clang fp contract(off)
+a[r]+=scale*d0;b[r]+=scale*d1;
+}
+ }
+}
+float global=global_scale[expert]/2688.0f;
+#pragma unroll
+for(int r=0;r<RPS;++r){
