+            ("RPS", 1),
+            ("EXPERT", x.size // k == count),
+            ("CLAMP", limit is not None),
+        ],
+        grid=(32, n, count),
+        threadgroup=(32, 2, 1),
+        output_shapes=[(count, n)],
+        output_dtypes=[x.dtype],
+    )[0].reshape(*indices.shape, 1, n)
