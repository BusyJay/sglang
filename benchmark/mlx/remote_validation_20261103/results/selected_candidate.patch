+        inputs=[
+            x.reshape(-1, k),
+            gate_weight,
+            gate_scales,
+            gate_global_scale.reshape(-1),
+            up_weight,
+            up_scales,
+            up_global_scale.reshape(-1),
+            indices.reshape(-1),
+            mx.array([k, n, picks], mx.int32),
+            mx.array([limit or 0], mx.float32),
+        ],
+        template=[
