@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: Apache-2.0
+// Included inside namespace sglang, after the serial policy kernel.
+namespace details {
+
+__device__ inline uint64_t candidate_heat_key(double value) {
+  uint64_t bits = static_cast<uint64_t>(__double_as_longlong(value));
+  if ((bits << 1) == 0) bits = 0;  // Canonicalize signed zero.
+  return bits & (uint64_t{1} << 63) ? ~bits : bits ^ (uint64_t{1} << 63);
+}
+
+__device__ inline bool parallel_victim_less(const HybridVictim& a, const HybridVictim& b) {
+  uint64_t x = candidate_heat_key(a.heat), y = candidate_heat_key(b.heat);
+  if (x != y) return x < y;
+  if (a.layer != b.layer) return a.layer < b.layer;
+  return a.expert < b.expert;
+}
+
+__device__ inline HybridVictim scan_partition(
+    const double* frequency,
+    const int32_t* owners,
+    const int32_t* keys,
+    const int32_t* histogram,
+    int32_t slots,
+    int32_t experts,
+    int32_t layer,
+    double decay,
+    bool after_cold_reclaim,
+    HybridVictim previous,
+    bool skip_previous) {
+  HybridVictim best{std::numeric_limits<double>::infinity(), INT32_MAX, INT32_MAX, -1};
+  for (int32_t s = threadIdx.x; s < slots; s += blockDim.x) {
+    int32_t owner = owners[s], expert = keys[s];
+    if (owner == -2) continue;
+    if (expert >= 0 && owner == layer && histogram[expert]) continue;
+    double heat = expert < 0 ? -1.0 : frequency[static_cast<int64_t>(owner) * experts + expert];
+    if (expert >= 0 && owner == layer) heat = __dmul_rn(heat, decay);
+    bool free =
+        expert < 0 || (after_cold_reclaim && owner == layer && candidate_heat_key(heat) < candidate_heat_key(0.5));
+    HybridVictim candidate = free ? HybridVictim{-1.0, -1, s, s} : HybridVictim{heat, owner, expert, s};
+    if ((!skip_previous || parallel_victim_less(previous, candidate)) && parallel_victim_less(candidate, best))
+      best = candidate;
+  }
+  return best;
+}
+
+// One minimum per thread, then a CTA reduction. Only the winning partition
+// is rescanned for its successor; no per-slot heap or persistent index exists.
+template <bool Cached>
+__global__ void parallel_candidates_kernel(
+    const int32_t* ids,
+    const int32_t* lookup,
+    const double* frequency,
+    const int32_t* owners,
+    const int32_t* keys,
+    HybridVictim* output,
+    int32_t routes,
+    int32_t experts,
+    int32_t slots,
+    int32_t layer,
+    double decay) {
+  __shared__ int32_t histogram[512], misses, invalid;
+  __shared__ HybridVictim warp_candidates[8 * kRoutes];
+  extern __shared__ double cached_heat[];
+  auto* cached_keys = reinterpret_cast<uint32_t*>(cached_heat + slots);
+  for (int32_t e = threadIdx.x; e < experts; e += blockDim.x)
+    histogram[e] = 0;
+  if (threadIdx.x == 0) invalid = 0;
+  __syncthreads();
+  for (int32_t r = threadIdx.x; r < routes; r += blockDim.x) {
+    int32_t e = ids[r];
+    if (e >= 0 && e < experts)
+      atomicAdd(histogram + e, 1);
+    else if (e != -1)
+      atomicExch(&invalid, 1);
+  }
+  __syncthreads();
+  if (invalid) {
+    if (threadIdx.x == 0) asm volatile("trap;");
+    return;
+  }
+  if (threadIdx.x == 0) {
+    misses = 0;
+    for (int32_t e = 0; e < experts; ++e)
+      misses += histogram[e] && lookup[layer * experts + e] < 0;
+  }
+  __syncthreads();
+  if (!misses) return;
+  if (Cached) {
+    for (int32_t s = threadIdx.x; s < slots; s += blockDim.x) {
+      int32_t owner = owners[s], e = keys[s];
+      cached_heat[s] = std::numeric_limits<double>::infinity();
+      cached_keys[s] = UINT32_MAX - 1;
+      if (owner == -2 || (e >= 0 && owner == layer && histogram[e])) continue;
+      cached_keys[s] = e < 0 ? UINT32_MAX : owner * experts + e;
+      double heat = e < 0 ? -1.0 : frequency[static_cast<int64_t>(owner) * experts + e];
+      cached_heat[s] = owner == layer && e >= 0 ? __dmul_rn(heat, decay) : heat;
+    }
+  }
+  __syncthreads();
+  auto scan = [&](bool phase, HybridVictim previous, bool skip_previous) {
+    if (!Cached)
+      return scan_partition(
+          frequency, owners, keys, histogram, slots, experts, layer, decay, phase, previous, skip_previous);
+    HybridVictim best{std::numeric_limits<double>::infinity(), INT32_MAX, INT32_MAX, -1};
+    for (int32_t s = threadIdx.x; s < slots; s += blockDim.x) {
+      uint32_t key = cached_keys[s];
+      if (key == UINT32_MAX - 1) continue;
+      double heat = cached_heat[s];
+      bool free = key == UINT32_MAX || (phase && key >= layer * experts && key < (layer + 1) * experts &&
+                                        candidate_heat_key(heat) < candidate_heat_key(0.5));
+      HybridVictim candidate =
+          free ? HybridVictim{-1.0, -1, s, s} : HybridVictim{heat, static_cast<int32_t>(key), 0, s};
+      if ((!skip_previous || parallel_victim_less(previous, candidate)) && parallel_victim_less(candidate, best))
+        best = candidate;
+    }
+    return best;
+  };
+  for (int phase = 0; phase < 2; ++phase) {
+    HybridVictim local = scan(phase, {}, false);
+    int32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+    for (int32_t i = 0; i < misses; ++i) {
+      HybridVictim reduced = local;
+      for (int32_t delta = 16; delta; delta /= 2) {
+        HybridVictim other;
+        other.heat = __shfl_down_sync(0xffffffff, reduced.heat, delta);
+        other.layer = __shfl_down_sync(0xffffffff, reduced.layer, delta);
+        other.expert = __shfl_down_sync(0xffffffff, reduced.expert, delta);
+        other.slot = __shfl_down_sync(0xffffffff, reduced.slot, delta);
+        if (lane + delta < 32 && parallel_victim_less(other, reduced)) reduced = other;
+      }
+      int32_t slot = __shfl_sync(0xffffffff, reduced.slot, 0);
+      if (lane == 0) warp_candidates[warp * kRoutes + i] = reduced;
+      if (i + 1 < misses && slot >= 0 && slot % blockDim.x == threadIdx.x) local = scan(phase, local, true);
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+      int32_t positions[8] = {};
+      for (int32_t i = 0; i < misses; ++i) {
+        HybridVictim best{std::numeric_limits<double>::infinity(), INT32_MAX, INT32_MAX, -1};
+        int32_t winner = -1;
+        for (int32_t w = 0; w < 8; ++w) {
+          if (positions[w] == misses) continue;
+          HybridVictim candidate = warp_candidates[w * kRoutes + positions[w]];
+          if (parallel_victim_less(candidate, best)) {
+            best = candidate;
+            winner = w;
+          }
+        }
+        if (winner >= 0) ++positions[winner];
+        if (Cached && best.slot >= 0 && best.layer >= 0) {
+          best.expert = best.layer % experts;
+          best.layer /= experts;
+        }
+        output[phase * kRoutes + i] = best;
+      }
+    }
+    __syncthreads();
+  }
+}
+#include "qwen38_register_candidates.cuh"
+}  // namespace details
