+// SPDX-License-Identifier: Apache-2.0
+// Included inside sglang::details. The serving pool fits 256 x 32 leaves.
+__global__ void register_candidates_kernel(
+    const int32_t* ids,
+    const int32_t* lookup,
+    const double* frequency,
+    const int32_t* owners,
+    const int32_t* keys,
+    HybridVictim* output,
+    int32_t routes,
+    int32_t experts,
+    int32_t slots,
+    int32_t layer,
+    double decay) {
+  __shared__ int32_t histogram[512], misses, invalid;
+  __shared__ HybridVictim warp_candidates[8 * kRoutes];
+  for (int32_t e = threadIdx.x; e < experts; e += blockDim.x)
+    histogram[e] = 0;
+  if (threadIdx.x == 0) invalid = 0;
+  __syncthreads();
+  for (int32_t r = threadIdx.x; r < routes; r += blockDim.x) {
+    int32_t e = ids[r];
+    if (e >= 0 && e < experts)
+      atomicAdd(histogram + e, 1);
+    else if (e != -1)
+      atomicExch(&invalid, 1);
+  }
+  __syncthreads();
+  if (invalid) {
+    if (threadIdx.x == 0) asm volatile("trap;");
+    return;
+  }
+  if (threadIdx.x == 0) {
+    misses = 0;
+    for (int32_t e = 0; e < experts; ++e)
+      misses += histogram[e] && lookup[layer * experts + e] < 0;
+  }
+  __syncthreads();
+  if (!misses) return;
+  uint64_t heat_keys[32];
+  uint32_t expert_keys[32];
+#pragma unroll
+  for (int32_t j = 0; j < 32; ++j) {
+    int32_t s = threadIdx.x + 256 * j;
+    heat_keys[j] = UINT64_MAX;
+    expert_keys[j] = UINT32_MAX - 1;
+    if (s >= slots) continue;
+    int32_t owner = owners[s], e = keys[s];
+    if (owner == -2 || (e >= 0 && owner == layer && histogram[e])) continue;
+    expert_keys[j] = e < 0 ? UINT32_MAX : owner * experts + e;
+    double heat = e < 0 ? -1.0 : frequency[static_cast<int64_t>(owner) * experts + e];
+    if (owner == layer && e >= 0) heat = __dmul_rn(heat, decay);
+    heat_keys[j] = candidate_heat_key(heat);
+  }
+  int32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+  for (int32_t phase = 0; phase < 2; ++phase) {
+    uint64_t local_heat = UINT64_MAX, previous_heat = 0;
+    uint32_t local_key = UINT32_MAX, previous_key = 0;
+    int32_t local_slot = -1, winner_slot = -1;
+    for (int32_t i = 0; i < misses; ++i) {
+      if (i == 0 || (winner_slot >= 0 && winner_slot % 256 == threadIdx.x)) {
+        if (i) {
+          previous_heat = local_heat;
+          previous_key = local_key;
+        }
+        local_heat = UINT64_MAX;
+        local_key = UINT32_MAX;
+        local_slot = -1;
+#pragma unroll
+        for (int32_t j = 0; j < 32; ++j) {
+          uint32_t key = expert_keys[j];
+          if (key == UINT32_MAX - 1) continue;
+          int32_t s = threadIdx.x + 256 * j;
+          bool free = key == UINT32_MAX || (phase && key >= layer * experts && key < (layer + 1) * experts &&
+                                            heat_keys[j] < candidate_heat_key(0.5));
+          uint64_t heat = free ? candidate_heat_key(-1.0) : heat_keys[j];
+          uint32_t order = free ? s : key;
+          bool after = !i || heat > previous_heat || (heat == previous_heat && order > previous_key);
+          if (after && (heat < local_heat || (heat == local_heat && order < local_key))) {
+            local_heat = heat;
+            local_key = order;
+            local_slot = s;
+          }
+        }
+      }
+      uint64_t heat = local_heat;
+      uint32_t key = local_key;
+      int32_t slot = local_slot;
+      for (int32_t delta = 16; delta; delta /= 2) {
+        uint64_t other_heat = __shfl_down_sync(0xffffffff, heat, delta);
+        uint32_t other_key = __shfl_down_sync(0xffffffff, key, delta);
+        int32_t other_slot = __shfl_down_sync(0xffffffff, slot, delta);
+        if (lane + delta < 32 && (other_heat < heat || (other_heat == heat && other_key < key))) {
+          heat = other_heat;
+          key = other_key;
+          slot = other_slot;
+        }
+      }
+      winner_slot = __shfl_sync(0xffffffff, slot, 0);
+      if (lane == 0) {
+        bool free = heat == candidate_heat_key(-1.0);
+        uint64_t bits = heat & (uint64_t{1} << 63) ? heat ^ (uint64_t{1} << 63) : ~heat;
+        double value = slot < 0 ? std::numeric_limits<double>::infinity() : __longlong_as_double(bits);
+        warp_candidates[warp * kRoutes + i] = {
+            value, slot < 0 ? INT32_MAX : (free ? -1 : static_cast<int32_t>(key)), free ? slot : 0, slot};
+      }
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+      int32_t positions[8] = {};
+      for (int32_t i = 0; i < misses; ++i) {
+        HybridVictim best{std::numeric_limits<double>::infinity(), INT32_MAX, INT32_MAX, -1};
+        int32_t winner = -1;
+        for (int32_t w = 0; w < 8; ++w) {
+          if (positions[w] == misses) continue;
+          HybridVictim candidate = warp_candidates[w * kRoutes + positions[w]];
+          if (parallel_victim_less(candidate, best)) {
+            best = candidate;
+            winner = w;
+          }
+        }
+        if (winner >= 0) ++positions[winner];
+        if (best.slot >= 0 && best.layer >= 0) {
+          best.expert = best.layer % experts;
+          best.layer /= experts;
+        }
+        output[phase * kRoutes + i] = best;
+      }
+    }
+    __syncthreads();
+  }
+}
